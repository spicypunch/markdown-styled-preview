{
  "name": "markdown-styled-preview",
  "version": "0.1.0",
  "productName": "Markdown Styled Preview",
  "description": "Desktop Markdown editor with a live styled preview panel.",
  "license": "MIT",
  "author": "spicypunch",
  "homepage": "https://github.com/spicypunch/markdown-styled-preview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spicypunch/markdown-styled-preview.git"
  },
  "bugs": {
    "url": "https://github.com/spicypunch/markdown-styled-preview/issues"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "desktop:build": "npm run build",
    "dist:mac": "npm run build && electron-builder --mac zip --publish never",
    "package:mac": "npm run build && electron-builder --mac dir --publish never && npm run sign:mac",
    "sign:mac": "codesign --force --deep --sign - \"release/mac-arm64/Markdown Styled Preview.app\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke:pdf": "electron scripts/pdf-smoke.cjs",
    "smoke:visual": "electron scripts/smoke-capture.cjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.10",
    "concurrently": "^10.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "wait-on": "^9.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.local.markdown-styled-preview",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dir"
      ]
    }
  }
}
